{
  "name": "biblioteca-api",
  "version": "0.1.0",
  "description": "API REST de la Guía de servicios de la Biblioteca de la Alameda (Taller Full Stack, ITT)",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/data/seed.js",
    "test": "node --test test/",
    "build:three": "esbuild scripts/three-entrada.js --bundle --format=esm --minify --legal-comments=none --outfile=public/vendor/three.bundle.js"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "rate-limit-redis": "^4.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.187.0"
  }
}
