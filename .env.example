# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a GitHub.
NODE_ENV=development
PORT=3000

# Secreto de la aplicación para indexar correos. En producción: cadena aleatoria de 32+ caracteres.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Vigencia por inactividad de sesión web (30 minutos por defecto).
SESSION_TTL_SECONDS=1800

# Código privado que debe coincidir con el código del QR. En producción usa uno aleatorio de 16+ caracteres.
QR_ACCESS_CODE=

# Límite de intentos
RATE_GLOBAL_MAX=100
RATE_GLOBAL_WINDOW_MIN=15
RATE_AUTH_MAX=10
RATE_AUTH_WINDOW_MIN=15

# Redis contiene las cuentas, sesiones, preferencias, guías y métricas.
# Ejemplo local sin contraseña:
REDIS_URL=redis://127.0.0.1:6379
# Para producción, usa autenticación y TLS (rediss://) y no expongas Redis a Internet.
CACHE_TTL_SECONDS=600

# true si el servidor está detrás de un proxy confiable (por ejemplo Nginx o Render)
TRUST_PROXY=false
