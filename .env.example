# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a GitHub.
NODE_ENV=development
PORT=3000

# Secreto con el que se indexan los correos en Redis (HMAC). Obligatorio en producción: 32+ caracteres.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Vigencias: la sesión dura SESSION_TTL_SECONDS y se renueva con cada uso; el pase QR, QR_PASS_MIN minutos.
SESSION_TTL_SECONDS=1800
QR_PASS_MIN=240

# Límite de intentos
RATE_GLOBAL_MAX=100
RATE_GLOBAL_WINDOW_MIN=15
RATE_AUTH_MAX=10
RATE_AUTH_WINDOW_MIN=15

# Redis guarda cuentas, sesiones y los contadores de intentos. Obligatorio en producción.
# Vacío en desarrollo = redis://127.0.0.1:6379. Ejemplo con contraseña: redis://:tu-contraseña@127.0.0.1:6379
REDIS_URL=
CACHE_TTL_SECONDS=600

# true si el servidor está detrás de un proxy (por ejemplo Nginx o Render)
TRUST_PROXY=false
