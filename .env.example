# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a GitHub.
NODE_ENV=development
PORT=3000

# Obligatorio en producción: cadena aleatoria de 32+ caracteres.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Vigencias (en minutos)
JWT_EXPIRES_MIN=120
QR_PASS_MIN=240

# Límite de intentos
RATE_GLOBAL_MAX=100
RATE_GLOBAL_WINDOW_MIN=15
RATE_AUTH_MAX=10
RATE_AUTH_WINDOW_MIN=15

# Redis (caché, límite de intentos y sesiones cerradas). Déjalo vacío para trabajar sin Redis.
# Ejemplo con contraseña: redis://:tu-contraseña@127.0.0.1:6379
REDIS_URL=
CACHE_TTL_SECONDS=600

# true si el servidor está detrás de un proxy (por ejemplo Nginx o Render)
TRUST_PROXY=false
